# ==============================================================================
# AUTO-CONNECT DEFAULT: dashboard ini SUDAH otomatis tersambung ke Google
# Sheet Live Response berikut tanpa perlu mengisi apapun di file ini:
#   https://docs.google.com/spreadsheets/d/1Gt7w2LLRVhGnhEsNOVeewR2rvcs4AhKfbQeNgAn7cUU/edit#gid=1952116967
# Ia membangun URL export CSV otomatis dari SHEET_ID + GID (lihat src/data/config.js)
# dan mem-poll setiap 30 detik. Syaratnya HANYA: sheet dibagikan minimal sebagai
# "Anyone with the link — Viewer" (Share -> General access).
#
# Isi variabel di bawah HANYA jika ingin mengganti sheet/gid default, atau
# jika sheet perlu dibuat lebih privat lewat Google Sheets API v4.
# ==============================================================================

# Ganti sheet & tab default (opsional)
VITE_SHEET_ID=1Gt7w2LLRVhGnhEsNOVeewR2rvcs4AhKfbQeNgAn7cUU
VITE_SHEET_GID=1952116967

# Override manual (opsional): link "Publish to web" CSV kustom, jika export
# otomatis di atas suatu saat diblokir oleh kebijakan sharing organisasi
VITE_SHEET_CSV_URL=

# Opsional: Google Sheets API v4 (butuh API key dari Google Cloud Console)
# jika sheet perlu diakses lewat jalur yang mendukung autentikasi
VITE_GOOGLE_API_KEY=

# Jika koneksi live gagal total (mis. offline / sheet belum di-share publik),
# dashboard otomatis jatuh ke mode demo (data dummy) agar tetap bisa dipakai.
